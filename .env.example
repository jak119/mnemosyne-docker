# Compose active profiles: 'mcp' (MCP server only), 'sync' (Sync server only), or 'all' (both)
COMPOSE_PROFILES=mcp

# MCP Server Configuration
MNEMOSYNE_MCP_TOKEN=
MNEMOSYNE_HOST=0.0.0.0
MNEMOSYNE_PORT=8080
MNEMOSYNE_LLM_ENABLED=false

# Sync Server Configuration
MNEMOSYNE_SYNC_API_KEY=
MNEMOSYNE_SYNC_HOST=0.0.0.0
MNEMOSYNE_SYNC_PORT=8765

# Image Tag
MNEMOSYNE_IMAGE_TAG=latest
